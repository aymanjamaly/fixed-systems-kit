# ─────────────────────────────────────────────────────────────
# Secrets split by HOME. Put each where its code runs.
#   Receiver (Vercel): the verify secrets + TRIGGER_SECRET_KEY
#   Task (Trigger.dev dashboard): the action keys
# Never commit this file.
# ─────────────────────────────────────────────────────────────

# ── Trigger.dev — needed to trigger tasks (both homes) ──
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxx

# ── RECEIVER home (Vercel) — one verify secret per event source ──
SOURCE_WEBHOOK_SECRET=        # generic HMAC sources (Cal.com, custom)
SHOPIFY_WEBHOOK_SECRET=       # Shopify: the store's webhook signing secret
TELEGRAM_SECRET_TOKEN=        # the secret you passed to Telegram setWebhook

# ── TASK home (Trigger.dev) — action keys the engine uses ──
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
NOTION_API_KEY=
NOTION_DATABASE_ID=
RESEND_API_KEY=
FROM_EMAIL=
