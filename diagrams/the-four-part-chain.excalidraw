      "link": null,
      "locked": false,
      "type": "text",
      "text": "Every fixed system is the same four-part chain",
      "fontSize": 30,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 25,
      "containerId": null,
      "originalText": "Every fixed system is the same four-part chain",
      "lineHeight": 1.25
    },
    {
      "id": "text-4",
      "x": 96,
      "y": 168,
      "width": 1180,
      "height": 40,
      "angle": 0,
      "strokeColor": "#6b7280",
      "backgroundColor": "transparent",
