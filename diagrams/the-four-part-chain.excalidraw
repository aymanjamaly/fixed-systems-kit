      "roundness": null,
      "seed": 320162426,
      "versionNonce": 731575534,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785080220407,
      "link": null,
      "locked": false,
      "type": "text",
      "text": "Every step is decided in advance. The system's job is to run the steps reliably — never to decide them. That one word is what separates this whole section from thinking systems.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "Every step is decided in advance. The system's job is to run the steps reliably — never to decide them. That one word is what separates this whole section from thinking systems.",
      "lineHeight": 1.25
    },
