      "type": "text",
      "text": "FIXED = pre-decided",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "FIXED = pre-decided",
      "lineHeight": 1.25
    },
    {
      "id": "text-43",
      "x": 340,
      "y": 540,
      "width": 1304,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#1f2430",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
