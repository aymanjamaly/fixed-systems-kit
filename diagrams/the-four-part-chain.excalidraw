      "isDeleted": false,
      "boundElements": [],
      "updated": 1785080220405,
      "link": null,
      "locked": false,
      "type": "text",
      "text": "Learn this once and it fits every automation you'll ever build for a client. Something produces a signal, a trigger fires, an engine runs the\nsteps you defined, an action lands in the real world.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Learn this once and it fits every automation you'll ever build for a client. Something produces a signal, a trigger fires, an engine runs the\nsteps you defined, an action lands in the real world.",
      "lineHeight": 1.25
    },
